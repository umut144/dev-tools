#!/usr/bin/env python3
"""
compressimgs - Bilder verkleinern/komprimieren, bevor sie einer Claude-
Session vorgelegt werden. Nutzt ausschliesslich `sips` (in macOS eingebaut)
- keine Abhaengigkeiten, kein pip/brew noetig.

Ohne Argumente: durchsucht das AKTUELLE Verzeichnis rekursiv (alle
Unterordner) nach .jpg/.jpeg/.png und legt neben jedem Original eine
komprimierte Kopie mit "_compressed" im Namen an, z.B.:
    karte_drache.png  ->  karte_drache_compressed.png
Originale werden nie angefasst. Schon komprimierte Dateien (erkannt am
"_compressed"-Suffix) werden nie als Quelle behandelt, und eine bereits
vorhandene, aktuelle _compressed-Datei wird nicht neu erzeugt (Zeitstempel-
Vergleich) - erneutes Aufrufen im selben Ordner ist also guenstig.

Mit expliziten Dateien als Argumente: nur diese verarbeiten, keine
Rekursion.

Beispiele:
  compressimgs                          # alles unter dem aktuellen Ordner
  compressimgs --max-dim 1600 --quality 80
  compressimgs karte_drache.png         # nur eine Datei
  compressimgs --root reference_drawings
  compressimgs --redo                   # bestehende _compressed-Dateien neu erzeugen

Falls die numerische --quality auf deiner macOS-Version von sips nicht
angenommen wird (manche Quellen dokumentieren nur low/normal/high/best/
default statt einer Zahl), ein Schluesselwort statt einer Zahl uebergeben,
z.B. --quality high. Ein sips-Fehler wird klar angezeigt, es entsteht nie
still eine kaputte oder fehlende Datei.
"""
import argparse
import os
import subprocess
import sys

SIPS = "/usr/bin/sips"
IMAGE_EXT = {".jpg", ".jpeg", ".png"}
SUFFIX = "_compressed"
EXCLUDE_DIRS = {".git", "target", "node_modules", "__pycache__",
                ".venv", "venv", ".agent-check"}


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def is_already_compressed(path):
    stem = os.path.splitext(os.path.basename(path))[0]
    return stem.endswith(SUFFIX)


def find_recursive(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
        for fn in sorted(filenames):
            ext = os.path.splitext(fn)[1].lower()
            if ext in IMAGE_EXT and not is_already_compressed(fn):
                yield os.path.join(dirpath, fn)


def dest_for(src, to_jpeg):
    d = os.path.dirname(src)
    stem, ext = os.path.splitext(os.path.basename(src))
    out_ext = ".jpg" if to_jpeg else ext
    return os.path.join(d, f"{stem}{SUFFIX}{out_ext}")


def compress_one(src, max_dim, quality, force_jpeg, redo):
    ext = os.path.splitext(src)[1].lower()
    to_jpeg = force_jpeg or ext in (".jpg", ".jpeg")
    dst = dest_for(src, to_jpeg)

    if os.path.exists(dst) and not redo:
        try:
            if os.path.getmtime(dst) >= os.path.getmtime(src):
                return "skip", dst, None
        except OSError:
            pass

    orig_size = os.path.getsize(src)
    cmd = [SIPS, "-Z", str(max_dim)]
    if to_jpeg:
        cmd += ["-s", "format", "jpeg", "-s", "formatOptions", str(quality)]
    cmd += [src, "--out", dst]

    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not os.path.exists(dst):
        return "error", (r.stderr or r.stdout).strip(), None

    new_size = os.path.getsize(dst)
    return "ok", orig_size, new_size


def main():
    ap = argparse.ArgumentParser(
        description="Bilder fuer Claude verkleinern/komprimieren (sips, "
                     "keine Abhaengigkeiten). Ueberschreibt nie Originale.")
    ap.add_argument("images", nargs="*",
                     help="bestimmte Bilddateien statt rekursivem Scan")
    ap.add_argument("--root", default=".",
                     help="Wurzelordner fuer den rekursiven Scan, Default: "
                          "aktuelles Verzeichnis")
    ap.add_argument("--max-dim", type=int, default=2048,
                     help="laengste Kante in Pixeln, Default 2048")
    ap.add_argument("--quality", default="82",
                     help="JPEG-Qualitaet: Zahl 0-100 ODER low/normal/high/"
                          "best/default. Default 82")
    ap.add_argument("--force-jpeg", action="store_true",
                     help="auch PNGs verlustbehaftet zu JPEG wandeln - "
                          "kleiner, aber keine Transparenz mehr")
    ap.add_argument("--redo", action="store_true",
                     help="bestehende _compressed-Dateien neu erzeugen "
                          "statt sie zu ueberspringen")
    args = ap.parse_args()

    if not os.path.exists(SIPS):
        print("sips nicht gefunden - dieses Skript ist macOS-spezifisch.",
              file=sys.stderr)
        return 1

    if args.images:
        sources = [p for p in args.images
                   if os.path.isfile(p) and not is_already_compressed(p)]
        scope = f"{len(sources)} angegebene Datei(en)"
    else:
        sources = list(find_recursive(args.root))
        scope = f"{len(sources)} Bild(er) unter {os.path.abspath(args.root)}"

    if not sources:
        print("Keine passenden Bilder gefunden (.jpg/.jpeg/.png, "
              "nicht bereits _compressed).")
        return 0

    print(f"{scope}\n")
    total_before = total_after = 0
    ok = skipped = failed = 0
    for src in sources:
        status, a, b = compress_one(src, args.max_dim, args.quality,
                                     args.force_jpeg, args.redo)
        if status == "skip":
            skipped += 1
            print(f"  {src:<55} bereits aktuell -> {os.path.basename(a)}")
        elif status == "error":
            failed += 1
            print(f"  FEHLER  {src}: {a}", file=sys.stderr)
        else:
            ok += 1
            orig_size, new_size = a, b
            total_before += orig_size
            total_after += new_size
            saved = 100 * (1 - new_size / orig_size) if orig_size else 0
            print(f"  {src:<55} {human(orig_size):>9} -> "
                  f"{human(new_size):>9}  ({saved:4.0f}% kleiner)")

    print()
    if ok:
        saved = 100 * (1 - total_after / total_before) if total_before else 0
        print(f"{ok} komprimiert ({human(total_before)} -> "
              f"{human(total_after)}, {saved:.0f}% kleiner), "
              f"{skipped} schon aktuell, {failed} fehlgeschlagen.")
    else:
        print(f"0 komprimiert, {skipped} schon aktuell, "
              f"{failed} fehlgeschlagen.")
    print("Originale unveraendert.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
