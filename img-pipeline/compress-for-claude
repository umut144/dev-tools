#!/usr/bin/env python3
"""
compress-for-claude - Bilder verkleinern/komprimieren, bevor sie einer
Claude-Session vorgelegt werden (z.B. Referenzbilder, Screenshots, Karten-
Mockups). Nutzt ausschliesslich `sips` (in macOS eingebaut) - keine
Abhaengigkeiten, kein pip/brew noetig.

Sicherheitsprinzip: das Original wird NIE angefasst. Jede Ausgabe landet in
einem separaten Ordner (Default: "compressed/" neben dem ersten Bild).

Beispiele:
  compress-for-claude karte_drache.png
  compress-for-claude --max-dim 1600 --quality 80 referenzen/*.jpg
  compress-for-claude --out-dir ~/Desktop/game04/fuer-claude *.png

Verhalten je Format:
  PNG   -> bleibt PNG, nur verkleinert (verlustfrei in der Bildqualitaet,
           behaelt Transparenz). --force-jpeg erzwingt trotzdem JPEG.
  JPEG/HEIC/TIFF/BMP/GIF -> verkleinert UND mit --quality neu komprimiert
           (als JPEG ausgegeben).

Falls die numerische --quality auf deiner macOS-Version von sips nicht
angenommen wird (manche Quellen dokumentieren stattdessen nur
low/normal/high/best/default), einfach ein Schluesselwort statt einer Zahl
uebergeben, z.B. --quality high. Das Skript meldet einen sips-Fehler klar
im Terminal, statt still eine kaputte/fehlende Datei zu erzeugen.
"""
import argparse
import os
import subprocess
import sys

SIPS = "/usr/bin/sips"
LOSSY_INPUT_EXT = {".jpg", ".jpeg", ".heic", ".heif", ".tiff", ".tif", ".bmp", ".gif"}


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def compress_one(src, out_dir, max_dim, quality, force_jpeg):
    if not os.path.isfile(src):
        print(f"  uebersprungen (keine Datei): {src}", file=sys.stderr)
        return None

    ext = os.path.splitext(src)[1].lower()
    base = os.path.splitext(os.path.basename(src))[0]
    orig_size = os.path.getsize(src)

    to_jpeg = force_jpeg or ext in LOSSY_INPUT_EXT
    out_ext = ".jpg" if to_jpeg else (ext or ".png")
    dst = os.path.join(out_dir, base + out_ext)

    cmd = [SIPS, "-Z", str(max_dim)]
    if to_jpeg:
        cmd += ["-s", "format", "jpeg", "-s", "formatOptions", str(quality)]
    cmd += [src, "--out", dst]

    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not os.path.exists(dst):
        print(f"  FEHLER bei {os.path.basename(src)}: "
              f"{(r.stderr or r.stdout).strip()}", file=sys.stderr)
        return None

    new_size = os.path.getsize(dst)
    saved = 100 * (1 - new_size / orig_size) if orig_size else 0
    print(f"  {os.path.basename(src):<40} {human(orig_size):>9} -> "
          f"{human(new_size):>9}  ({saved:4.0f}% kleiner)")
    return orig_size, new_size


def main():
    ap = argparse.ArgumentParser(
        description="Bilder fuer Claude verkleinern/komprimieren (sips, "
                     "keine Abhaengigkeiten). Ueberschreibt nie Originale.")
    ap.add_argument("images", nargs="+", help="Bilddateien (Pfade oder Glob)")
    ap.add_argument("--max-dim", type=int, default=2048,
                     help="laengste Kante in Pixeln, Default 2048")
    ap.add_argument("--quality", default="82",
                     help="JPEG-Qualitaet: Zahl 0-100 ODER low/normal/high/"
                          "best/default, je nachdem was deine sips-Version "
                          "annimmt. Default 82")
    ap.add_argument("--out-dir", default=None,
                     help="Zielordner, Default: <erstes Bild>/compressed")
    ap.add_argument("--force-jpeg", action="store_true",
                     help="auch PNGs verlustbehaftet zu JPEG wandeln - "
                          "kleiner, aber keine Transparenz mehr")
    args = ap.parse_args()

    if not os.path.exists(SIPS):
        print("sips nicht gefunden - dieses Skript ist macOS-spezifisch.",
              file=sys.stderr)
        return 1

    out_dir = args.out_dir or os.path.join(
        os.path.dirname(os.path.abspath(args.images[0])) or ".", "compressed")
    os.makedirs(out_dir, exist_ok=True)

    print(f"Ziel: {out_dir}\n")
    total_before = total_after = 0
    ok = 0
    for img in args.images:
        res = compress_one(img, out_dir, args.max_dim, args.quality,
                            args.force_jpeg)
        if res:
            b, a = res
            total_before += b
            total_after += a
            ok += 1

    print()
    if ok:
        saved = 100 * (1 - total_after / total_before) if total_before else 0
        print(f"{ok}/{len(args.images)} komprimiert: {human(total_before)} "
              f"-> {human(total_after)} ({saved:.0f}% kleiner)")
        print(f"Originale unveraendert. Kopien liegen in: {out_dir}")
    if ok < len(args.images):
        print(f"{len(args.images) - ok} fehlgeschlagen, siehe Fehler oben.",
              file=sys.stderr)
    return 0 if ok == len(args.images) else 1


if __name__ == "__main__":
    sys.exit(main())
