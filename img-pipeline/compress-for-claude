#!/usr/bin/env python3
"""
compressimgs - Bilder verkleinern/komprimieren, bevor sie einer Claude-
Session vorgelegt werden. Nutzt ausschliesslich `sips` und `xattr` (beide
in macOS eingebaut) - keine Abhaengigkeiten, kein pip/brew noetig.

Ohne Argumente: durchsucht das AKTUELLE Verzeichnis rekursiv (alle
Unterordner) nach .jpg/.jpeg/.png und legt neben jedem Original eine
komprimierte Kopie mit "_compressed" im Namen an, z.B.:
    karte_drache.png  ->  karte_drache_compressed.png
Originale werden nie angefasst. Schon komprimierte Dateien (erkannt am
"_compressed"-Suffix) werden nie als Quelle behandelt, und eine bereits
vorhandene, aktuelle _compressed-Datei wird nicht neu erzeugt (Zeitstempel-
Vergleich) - erneutes Aufrufen im selben Ordner ist also guenstig.

--replace: KEINE separate _compressed-Datei, sondern das Original wird
direkt an Ort und Stelle unter dem gleichen Namen ersetzt (unwiderruflich,
keine Sicherheitskopie!). Damit ein zweiter Lauf im selben Ordner ein
bereits ersetztes Bild nicht nochmal (verlustbehaftet) komprimiert, merkt
sich das Skript pro Datei ueber ein xattr (Dateiattribut, keine zusaetzliche
Datei im Ordner) den Zustand direkt nach dem Komprimieren. Nur Bilder, die
sich seitdem wirklich geaendert haben, werden neu komprimiert.

Mit expliziten Dateien als Argumente: nur diese verarbeiten, keine
Rekursion.

Beispiele:
  compressimgs                          # alles unter dem aktuellen Ordner
  compressimgs --max-dim 1600 --quality 80
  compressimgs karte_drache.png         # nur eine Datei
  compressimgs --root reference_drawings
  compressimgs --redo                   # bestehende Ausgaben neu erzeugen
  compressimgs --replace                # Originale direkt ersetzen, kein
                                         # zusaetzliches _compressed-Bild

Falls die numerische --quality auf deiner macOS-Version von sips nicht
angenommen wird (manche Quellen dokumentieren nur low/normal/high/best/
default statt einer Zahl), ein Schluesselwort statt einer Zahl uebergeben,
z.B. --quality high. Ein sips-Fehler wird klar angezeigt, es entsteht nie
still eine kaputte oder fehlende Datei.
"""
import argparse
import os
import shutil
import subprocess
import sys

SIPS = "/usr/bin/sips"
XATTR = "/usr/bin/xattr"
XATTR_KEY = "user.compressimgs.state"
IMAGE_EXT = {".jpg", ".jpeg", ".png"}
SUFFIX = "_compressed"
EXCLUDE_DIRS = {".git", "target", "node_modules", "__pycache__",
                ".venv", "venv", ".agent-check"}


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def is_already_compressed(path):
    stem = os.path.splitext(os.path.basename(path))[0]
    return stem.endswith(SUFFIX)


def find_recursive(root):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
        for fn in sorted(filenames):
            ext = os.path.splitext(fn)[1].lower()
            if ext in IMAGE_EXT and not is_already_compressed(fn):
                yield os.path.join(dirpath, fn)


def dest_for(src, to_jpeg):
    d = os.path.dirname(src)
    stem, ext = os.path.splitext(os.path.basename(src))
    out_ext = ".jpg" if to_jpeg else ext
    return os.path.join(d, f"{stem}{SUFFIX}{out_ext}")


def file_state(path):
    """Momentaufnahme (mtime:size) einer Datei, oder None wenn nicht lesbar."""
    try:
        return f"{os.path.getmtime(path):.6f}:{os.path.getsize(path)}"
    except OSError:
        return None


def read_marker(path):
    if not os.path.exists(XATTR):
        return None
    r = subprocess.run([XATTR, "-p", XATTR_KEY, path],
                        capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout.strip()


def write_marker(path):
    if not os.path.exists(XATTR):
        return
    state = file_state(path)
    if state is None:
        return
    subprocess.run([XATTR, "-w", XATTR_KEY, state, path],
                    capture_output=True, text=True)


def tmp_path_for(dst):
    d, base = os.path.split(dst)
    stem, ext = os.path.splitext(base)
    return os.path.join(d or ".", f".{stem}.compressimgs-tmp{ext}")


def get_dims(path):
    """(breite, hoehe) per sips, oder None wenn nicht ermittelbar."""
    r = subprocess.run([SIPS, "-g", "pixelWidth", "-g", "pixelHeight", path],
                        capture_output=True, text=True)
    if r.returncode != 0:
        return None
    w = h = None
    for line in r.stdout.splitlines():
        line = line.strip()
        if line.startswith("pixelWidth:"):
            w = int(line.split(":", 1)[1])
        elif line.startswith("pixelHeight:"):
            h = int(line.split(":", 1)[1])
    return (w, h) if w and h else None


def needs_resize(src, max_dim):
    """True nur, wenn die laengste Kante WIRKLICH groesser als max_dim ist.
    `sips -Z` skaliert sonst auch kleinere Bilder HOCH (mehr Pixel, groessere
    Datei). Unbekannte Groesse -> resizen; der Groessen-Check faengt es ab."""
    dims = get_dims(src)
    return dims is None or max(dims) > max_dim


def run_sips(src, dst, max_dim, quality, to_jpeg):
    cmd = [SIPS]
    if needs_resize(src, max_dim):
        cmd += ["-Z", str(max_dim)]
    if to_jpeg:
        cmd += ["-s", "format", "jpeg", "-s", "formatOptions", str(quality)]
    cmd += [src, "--out", dst]
    return subprocess.run(cmd, capture_output=True, text=True)


def compress_replace(src, max_dim, quality, force_jpeg, redo):
    ext = os.path.splitext(src)[1].lower()
    to_jpeg = force_jpeg or ext in (".jpg", ".jpeg")
    # Normalerweise bleibt der Name exakt gleich. Nur wenn --force-jpeg ein
    # PNG zu JPEG wandelt, MUSS sich die Endung aendern - dann wird das alte
    # .png danach entfernt, damit nicht zwei Dateien uebrig bleiben.
    changes_ext = to_jpeg and ext not in (".jpg", ".jpeg")
    dst = os.path.splitext(src)[0] + ".jpg" if changes_ext else src

    if not redo:
        state = file_state(src)
        if state is not None and read_marker(src) == state:
            return "skip", dst, None

    orig_size = os.path.getsize(src)
    if not changes_ext and not to_jpeg and not needs_resize(src, max_dim):
        # PNG, schon klein genug: sips wuerde nur neu kodieren -> nichts tun.
        write_marker(src)
        return "kept", orig_size, orig_size

    tmp_dst = tmp_path_for(dst)
    r = run_sips(src, tmp_dst, max_dim, quality, to_jpeg)
    if r.returncode != 0 or not os.path.exists(tmp_dst):
        if os.path.exists(tmp_dst):
            try:
                os.remove(tmp_dst)
            except OSError:
                pass
        return "error", (r.stderr or r.stdout).strip(), None

    if not changes_ext and os.path.getsize(tmp_dst) >= orig_size:
        # Ergebnis waere nicht kleiner -> Original behalten.
        os.remove(tmp_dst)
        write_marker(src)
        return "kept", orig_size, orig_size

    os.replace(tmp_dst, dst)          # atomarer Tausch, kein halb-fertiger Zustand
    if changes_ext:
        os.remove(src)                 # altes .png verschwindet, .jpg bleibt

    new_size = os.path.getsize(dst)
    write_marker(dst)
    return "ok", orig_size, new_size


def compress_sidecar(src, max_dim, quality, force_jpeg, redo):
    ext = os.path.splitext(src)[1].lower()
    to_jpeg = force_jpeg or ext in (".jpg", ".jpeg")
    dst = dest_for(src, to_jpeg)

    if os.path.exists(dst) and not redo:
        try:
            if os.path.getmtime(dst) >= os.path.getmtime(src):
                return "skip", dst, None
        except OSError:
            pass

    orig_size = os.path.getsize(src)
    same_format = os.path.splitext(dst)[1].lower() == ext
    if same_format and not to_jpeg and not needs_resize(src, max_dim):
        # PNG, schon klein genug: unveraendert als _compressed uebernehmen.
        shutil.copy2(src, dst)
        return "kept", orig_size, orig_size

    r = run_sips(src, dst, max_dim, quality, to_jpeg)
    if r.returncode != 0 or not os.path.exists(dst):
        return "error", (r.stderr or r.stdout).strip(), None

    new_size = os.path.getsize(dst)
    if same_format and new_size >= orig_size:
        # Ergebnis waere groesser als das Original -> Original kopieren.
        shutil.copy2(src, dst)
        return "kept", orig_size, orig_size
    return "ok", orig_size, new_size


def compress_one(src, max_dim, quality, force_jpeg, redo, replace):
    if replace:
        return compress_replace(src, max_dim, quality, force_jpeg, redo)
    return compress_sidecar(src, max_dim, quality, force_jpeg, redo)


def main():
    ap = argparse.ArgumentParser(
        description="Bilder fuer Claude verkleinern/komprimieren (sips, "
                     "keine Abhaengigkeiten).")
    ap.add_argument("images", nargs="*",
                     help="bestimmte Bilddateien statt rekursivem Scan")
    ap.add_argument("--root", default=".",
                     help="Wurzelordner fuer den rekursiven Scan, Default: "
                          "aktuelles Verzeichnis")
    ap.add_argument("--max-dim", type=int, default=2048,
                     help="laengste Kante in Pixeln, Default 2048")
    ap.add_argument("--quality", default="82",
                     help="JPEG-Qualitaet: Zahl 0-100 ODER low/normal/high/"
                          "best/default. Default 82")
    ap.add_argument("--force-jpeg", action="store_true",
                     help="auch PNGs verlustbehaftet zu JPEG wandeln - "
                          "kleiner, aber keine Transparenz mehr")
    ap.add_argument("--redo", action="store_true",
                     help="bestehende Ausgaben neu erzeugen statt sie zu "
                          "ueberspringen")
    ap.add_argument("--replace", action="store_true",
                     help="Original direkt unter gleichem Namen ersetzen "
                          "statt eine _compressed-Datei danebenzulegen. "
                          "UNWIDERRUFLICH, keine Sicherheitskopie.")
    args = ap.parse_args()

    if not os.path.exists(SIPS):
        print("sips nicht gefunden - dieses Skript ist macOS-spezifisch.",
              file=sys.stderr)
        return 1

    if args.images:
        sources = [p for p in args.images
                   if os.path.isfile(p) and not is_already_compressed(p)]
        scope = f"{len(sources)} angegebene Datei(en)"
    else:
        sources = list(find_recursive(args.root))
        scope = f"{len(sources)} Bild(er) unter {os.path.abspath(args.root)}"

    if not sources:
        print("Keine passenden Bilder gefunden (.jpg/.jpeg/.png, "
              "nicht bereits _compressed).")
        return 0

    if args.replace:
        print(f"{scope}  [--replace: Originale werden ersetzt, "
              f"unwiderruflich]\n")
    else:
        print(f"{scope}\n")

    total_before = total_after = 0
    ok = skipped = failed = kept = 0
    for src in sources:
        status, a, b = compress_one(src, args.max_dim, args.quality,
                                     args.force_jpeg, args.redo,
                                     args.replace)
        if status == "skip":
            skipped += 1
            print(f"  {src:<55} bereits aktuell -> {os.path.basename(a)}")
        elif status == "kept":
            kept += 1
            total_before += a
            total_after += b
            print(f"  {src:<55} {human(a):>9}  schon optimal, "
                  f"unveraendert uebernommen")
        elif status == "error":
            failed += 1
            print(f"  FEHLER  {src}: {a}", file=sys.stderr)
        else:
            ok += 1
            orig_size, new_size = a, b
            total_before += orig_size
            total_after += new_size
            saved = 100 * (1 - new_size / orig_size) if orig_size else 0
            print(f"  {src:<55} {human(orig_size):>9} -> "
                  f"{human(new_size):>9}  ({saved:4.0f}% kleiner)")

    print()
    if kept:
        print(f"{kept} Bild(er) waren schon klein genug und wurden nicht "
              f"veraendert (kein Hochskalieren, keine groessere Datei).")
    if ok:
        saved = 100 * (1 - total_after / total_before) if total_before else 0
        print(f"{ok} komprimiert ({human(total_before)} -> "
              f"{human(total_after)}, {saved:.0f}% kleiner), "
              f"{skipped} schon aktuell, {failed} fehlgeschlagen.")
    else:
        print(f"0 komprimiert, {skipped} schon aktuell, "
              f"{failed} fehlgeschlagen.")
    if args.replace:
        print("Originale ersetzt (kein Backup).")
    else:
        print("Originale unveraendert.")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
